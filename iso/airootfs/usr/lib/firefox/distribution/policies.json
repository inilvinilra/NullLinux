        "Status": "default"
      },
      "dom.security.https_only_mode": {
        "Value": true,
        "Status": "default"
      },
      "browser.contentblocking.category": {
        "Value": "strict",
        "Status": "default"
      },
      "network.cookie.cookieBehavior": {
