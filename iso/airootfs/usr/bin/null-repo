#!/usr/bin/env bash
# Enable or disable a third-party pacman repository, reversibly.
#
# Trust is established by comparing a full 40-hex fingerprint against the value
# the project publishes. Null Linux does not ship a fingerprint of its own for
# somebody else's key: a trust anchor you did not verify is not a trust anchor.
# Short key ids are refused outright — they are not collision resistant.
set -uo pipefail

VERSION="1.0.0"
PACMAN_CONF="${NULL_PACMAN_CONF:-/etc/pacman.conf}"
MARKER_BEGIN="# >>> null-repo:"
MARKER_END="# <<< null-repo:"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[0;33m'; BOLD=$'\033[1m'; NC=$'\033[0m'
[[ -t 1 ]] || { RED=''; GREEN=''; YELLOW=''; BOLD=''; NC=''; }

die() { printf '%serror:%s %s\n' "$RED" "$NC" "$*" >&2; exit 1; }

require_root() { [[ ${EUID} -eq 0 ]] || die "root required: sudo null-repo $*"; }

# repo -> mirrorlist package, section name, published-fingerprint reference
repo_docs() {
  case "$1" in
    blackarch) printf 'https://blackarch.org/downloads.html' ;;
    chaotic-aur) printf 'https://aur.chaotic.cx' ;;
    *) printf '' ;;
  esac
}

known_repo() { [[ -n "$(repo_docs "$1")" ]]; }

is_enabled() { grep -q "^${MARKER_BEGIN} $1\$" "$PACMAN_CONF"; }

normalise_fpr() {
  # Accept spaced fingerprints as printed by gpg; reject anything not 40 hex.
  local fpr="${1//[[:space:]]/}"
  fpr="${fpr^^}"
  [[ "$fpr" =~ ^[0-9A-F]{40}$ ]] || return 1
  printf '%s' "$fpr"
}

cmd_enable() {
  local repo="$1" fpr_input="${2:-}"
  require_root enable "$repo"
  known_repo "$repo" || die "unknown repository: $repo (known: blackarch, chaotic-aur)"
  is_enabled "$repo" && { printf 'Repository %s is already enabled.\n' "$repo"; exit 0; }

  [[ -n "$fpr_input" ]] || die "a full 40-hex key fingerprint is required
  Look it up at: $(repo_docs "$repo")
  Then run: null-repo enable $repo <FINGERPRINT>"

  local fpr
  fpr="$(normalise_fpr "$fpr_input")" || die "not a 40-hex fingerprint: '$fpr_input'
  A short or long key id is not a fingerprint and cannot establish trust."

  printf '%sImporting key %s%s\n' "$BOLD" "$fpr" "$NC"
  pacman-key --recv-keys "$fpr" || die "could not retrieve key $fpr"

  # Confirm the key the keyserver returned really carries that fingerprint.
  local got
  got="$(pacman-key --finger "$fpr" 2>/dev/null | tr -d ' \n' | grep -oE '[0-9A-F]{40}' | head -1)"
  [[ "$got" == "$fpr" ]] || die "retrieved key fingerprint does not match; refusing to trust it"

  printf '\n%sVerify this against %s before continuing.%s\n' "$YELLOW" "$(repo_docs "$repo")" "$NC"
  pacman-key --finger "$fpr"
  printf '\nDoes this fingerprint match the published value exactly? [type yes] '
  local answer; read -r answer
  [[ "$answer" == "yes" ]] || { printf 'Aborted. Nothing was changed.\n'; exit 0; }

  pacman-key --lsign-key "$fpr" || die "could not locally sign $fpr"

  local mirrorlist="/etc/pacman.d/${repo%-aur}-mirrorlist"
  [[ -f "$mirrorlist" ]] || die "missing $mirrorlist
  Install the repository's mirrorlist package first, verifying it against $fpr."

  cp -a "$PACMAN_CONF" "${PACMAN_CONF}.null-repo.bak"
  {
    printf '\n%s %s\n' "$MARKER_BEGIN" "$repo"
    printf '[%s]\n' "$repo"
    printf 'Include = %s\n' "$mirrorlist"
    printf '%s %s\n' "$MARKER_END" "$repo"
  } >> "$PACMAN_CONF"

  printf '%sEnabled %s.%s Previous config saved as %s.null-repo.bak\n' \
    "$GREEN" "$repo" "$NC" "$PACMAN_CONF"
  printf 'Run a full upgrade before installing from it: pacman -Syu\n'
}

cmd_disable() {
  local repo="$1"
  require_root disable "$repo"
  is_enabled "$repo" || { printf 'Repository %s is not enabled by null-repo.\n' "$repo"; exit 0; }

  cp -a "$PACMAN_CONF" "${PACMAN_CONF}.null-repo.bak"
  sed -i "/^${MARKER_BEGIN} ${repo}\$/,/^${MARKER_END} ${repo}\$/d" "$PACMAN_CONF"
  printf '%sDisabled %s.%s Packages already installed from it are untouched.\n' "$GREEN" "$repo" "$NC"
  printf 'Review them with: pacman -Qm\n'
}

cmd_status() {
  printf '%s%-14s %s%s\n' "$BOLD" "REPOSITORY" "STATE" "$NC"
  local repo
  for repo in blackarch chaotic-aur; do
    if is_enabled "$repo"; then
      printf '%-14s %senabled%s\n' "$repo" "$GREEN" "$NC"
    else
      printf '%-14s disabled\n' "$repo"
    fi
  done
  printf '\nOfficial Arch repositories are always enabled and are not managed here.\n'
}

case "${1:-}" in
  enable)  [[ -n "${2:-}" ]] || die "usage: null-repo enable <repo> <fingerprint>"; cmd_enable "$2" "${3:-}" ;;
  disable) [[ -n "${2:-}" ]] || die "usage: null-repo disable <repo>"; cmd_disable "$2" ;;
  status)  cmd_status ;;
  -v | --version) printf 'null-repo v%s\n' "$VERSION" ;;
  *)
    cat <<EOF
${BOLD}null-repo${NC} v${VERSION} — third-party repository control

  null-repo status
  null-repo enable  <repo> <full-40-hex-fingerprint>
  null-repo disable <repo>

Known repositories: blackarch, chaotic-aur

Enabling asks you to compare the key's full fingerprint against the value the
project publishes. A short key id is refused: it cannot establish trust.
Both operations back up ${PACMAN_CONF} and are reversible.
EOF
    ;;
esac
