#!/usr/bin/env bash
set -euo pipefail

CATALOG="/usr/share/null-welcome/catalog.yml"
MODE="dry-run"
GROUP_ID=""
ITEM_NAME=""

usage() {
  cat <<'EOF'
Usage:
  null-welcome-install --list-groups
  null-welcome-install --list-items <group-id>
  null-welcome-install --list-actions <group-id>
  null-welcome-install --group <group-id> [--apply]
  null-welcome-install --item <group-id>:<item-name> [--apply]
  null-welcome-install --action <action-id> [--apply]
  null-welcome-install [--catalog /path/to/catalog.yml]

Flags:
  --apply    Execute changes (default is dry-run)
EOF
}

require_python_yaml() {
  python - <<'PY'
import importlib.util,sys
sys.exit(0 if importlib.util.find_spec("yaml") else 1)
PY
}

list_groups() {
  python - "$CATALOG" <<'PY'
import sys,yaml
with open(sys.argv[1], encoding="utf-8") as f:
    data=yaml.safe_load(f)
for g in data.get("groups", []):
    print(f"{g.get('id','')} :: {g.get('title','')}")
PY
}

list_items() {
  local group_id="$1"
  python - "$CATALOG" "$group_id" <<'PY'
import sys,yaml
catalog,group_id=sys.argv[1],sys.argv[2]
with open(catalog, encoding="utf-8") as f:
    data=yaml.safe_load(f)
for g in data.get("groups", []):
    if g.get("id")==group_id:
        for item in g.get("items", []):
            print(item.get("name",""))
        sys.exit(0)
print(f"group not found: {group_id}", file=sys.stderr)
sys.exit(1)
PY
}

list_actions() {
  local group_id="$1"
  python - "$CATALOG" "$group_id" <<'PY'
import sys,yaml
catalog,group_id=sys.argv[1],sys.argv[2]
with open(catalog, encoding="utf-8") as f:
    data=yaml.safe_load(f)
for g in data.get("groups", []):
    if g.get("id")==group_id:
        for action in g.get("actions", []):
            print(f"{action.get('id','')} :: {action.get('label','')}")
        sys.exit(0)
print(f"group not found: {group_id}", file=sys.stderr)
sys.exit(1)
PY
}

get_group_packages() {
  local group_id="$1"
  python - "$CATALOG" "$group_id" <<'PY'
import sys,yaml
catalog,group_id=sys.argv[1],sys.argv[2]
with open(catalog, encoding="utf-8") as f:
    data=yaml.safe_load(f)
packages=[]
for g in data.get("groups", []):
    if g.get("id")==group_id:
        for item in g.get("items", []):
            for pkg in item.get("packages", []):
                packages.append(pkg)
        break
if not packages:
    sys.exit(1)
seen=set()
for p in packages:
    if p not in seen:
        seen.add(p)
        print(p)
PY
}

get_item_packages() {
  local group_id="$1"
  local item_name="$2"
  python - "$CATALOG" "$group_id" "$item_name" <<'PY'
import sys,yaml
catalog,group_id,item_name=sys.argv[1],sys.argv[2],sys.argv[3]
with open(catalog, encoding="utf-8") as f:
    data=yaml.safe_load(f)
for g in data.get("groups", []):
    if g.get("id")==group_id:
        for item in g.get("items", []):
            if item.get("name","").lower()==item_name.lower():
                for pkg in item.get("packages", []):
                    print(pkg)
                sys.exit(0)
sys.exit(1)
PY
}

run_action() {
  local action_id="$1"
  case "$action_id" in
    disable-ipv6)
      echo "Applying: disable IPv6"
      if [[ "$MODE" == "apply" ]]; then
        cat >/etc/sysctl.d/99-null-ipv6.conf <<'EOF'
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
EOF
        sysctl --system >/dev/null
      fi
      ;;
    disable-core-dumps)
      echo "Applying: disable core dumps"
      if [[ "$MODE" == "apply" ]]; then
        cat >/etc/security/limits.d/99-null-coredump.conf <<'EOF'
* hard core 0
* soft core 0
EOF
      fi
      ;;
    clear-system-cache)
      echo "Applying: clear package cache"
      if [[ "$MODE" == "apply" ]]; then
        pacman -Scc --noconfirm
      fi
      ;;
    enable-ufw)
      echo "Applying: enable UFW firewall"
      if [[ "$MODE" == "apply" ]]; then
        pacman -S --needed --noconfirm ufw
        ufw default deny incoming
        ufw default allow outgoing
        ufw --force enable
      fi
      ;;
    set-quad9-dns)
      echo "Applying: set Quad9 DNS"
      if [[ "$MODE" == "apply" ]]; then
        mkdir -p /etc/systemd/resolved.conf.d
        cat >/etc/systemd/resolved.conf.d/99-null-dns.conf <<'EOF'
[Resolve]
DNS=9.9.9.9 149.112.112.112
FallbackDNS=1.1.1.1 8.8.8.8
EOF
        systemctl enable systemd-resolved
        systemctl restart systemd-resolved
      fi
      ;;
    enable-tcp-bbr)
      echo "Applying: enable TCP BBR"
      if [[ "$MODE" == "apply" ]]; then
        cat >/etc/sysctl.d/99-null-bbr.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
        sysctl --system >/dev/null
      fi
      ;;
    optimize-mirrors)
      echo "Applying: optimize mirrors"
      if [[ "$MODE" == "apply" ]]; then
        reflector --latest 20 --protocol https --sort rate --save /etc/pacman.d/mirrorlist
      fi
      ;;
    remove-orphans)
      echo "Applying: remove orphaned packages"
      if [[ "$MODE" == "apply" ]]; then
        mapfile -t orphans < <(pacman -Qdtq || true)
        if [[ "${#orphans[@]}" -gt 0 ]]; then
          pacman -Rns --noconfirm "${orphans[@]}"
        fi
      fi
      ;;
    *)
      echo "Unknown action: $action_id" >&2
      return 1
      ;;
  esac
}

install_packages() {
  local -a pkgs=("$@")
  if [[ "${#pkgs[@]}" -eq 0 ]]; then
    echo "No packages selected."
    return 0
  fi
  echo "Packages (${#pkgs[@]}): ${pkgs[*]}"
  if [[ "$MODE" == "apply" ]]; then
    pacman -S --needed --noconfirm "${pkgs[@]}"
  fi
}

ACTION_ID=""
LIST_GROUPS=0
LIST_ITEMS=0
LIST_ACTIONS=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --catalog)
      CATALOG="$2"
      shift 2
      ;;
    --list-groups)
      LIST_GROUPS=1
      shift
      ;;
    --list-items)
      LIST_ITEMS=1
      GROUP_ID="$2"
      shift 2
      ;;
    --list-actions)
      LIST_ACTIONS=1
      GROUP_ID="$2"
      shift 2
      ;;
    --group)
      GROUP_ID="$2"
      shift 2
      ;;
    --item)
      pair="$2"
      GROUP_ID="${pair%%:*}"
      ITEM_NAME="${pair#*:}"
      shift 2
      ;;
    --action)
      ACTION_ID="$2"
      shift 2
      ;;
    --apply)
      MODE="apply"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ ! -f "$CATALOG" ]]; then
  echo "Catalog not found: $CATALOG" >&2
  exit 1
fi

if ! require_python_yaml; then
  echo "python-yaml is required." >&2
  exit 1
fi

if [[ "$LIST_GROUPS" -eq 1 ]]; then
  list_groups
  exit 0
fi

if [[ "$LIST_ITEMS" -eq 1 ]]; then
  list_items "$GROUP_ID"
  exit 0
fi

if [[ "$LIST_ACTIONS" -eq 1 ]]; then
  list_actions "$GROUP_ID"
  exit 0
fi

if [[ -n "$ACTION_ID" ]]; then
  run_action "$ACTION_ID"
  exit 0
fi

if [[ -n "$GROUP_ID" && -z "$ITEM_NAME" ]]; then
  mapfile -t packages < <(get_group_packages "$GROUP_ID")
  install_packages "${packages[@]}"
  exit 0
fi

if [[ -n "$GROUP_ID" && -n "$ITEM_NAME" ]]; then
  mapfile -t packages < <(get_item_packages "$GROUP_ID" "$ITEM_NAME")
  install_packages "${packages[@]}"
  exit 0
fi

usage
