#!/usr/bin/env bash
set -euo pipefail

category="${1:-all}"
tool_roots=(/home/tools /home/user/tools)

print_external_matches() {
  shift
  local patterns=("$@")
  local root
  local found=0

  for root in "${tool_roots[@]}"; do
    [[ -d "$root" ]] || continue
    for pattern in "${patterns[@]}"; do
      local path
      while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        printf "  [*] %s\n" "$path"
        found=1
      done < <(compgen -G "$root/$pattern" || true)
    done
  done

  if [[ "$found" -eq 0 ]]; then
    printf "  [*] %s\n" "No matching external tools found"
  fi
  echo
}

print_category() {
  local name="$1"
  shift
  echo "== $name =="
  for cmd in "$@"; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf "  [+] %s\n" "$cmd"
    else
      printf "  [-] %s (not installed)\n" "$cmd"
    fi
  done
  echo
}

case "$category" in
  red-team)
    print_category "Red Team" nmap sqlmap hydra nikto
    print_external_matches "Red Team External" \
      "*metasploit*" "*sliver*" "*empire*" "*sqlmap*" "*commix*" "*router*"
    ;;
  blue-team)
    print_category "Blue Team" suricata wireshark tcpdump ufw
    print_external_matches "Blue Team External" \
      "*caldera*" "*atomic-red-team*" "*BloodHound*" "*Responder*"
    ;;
  osint)
    print_category "OSINT" whois curl wget
    print_external_matches "OSINT External" \
      "*theHarvester*" "*recon-ng*" "*findomain*" "*wappalyzer*"
    ;;
  opsec)
    print_category "OPSEC" tor torsocks proxychains4 keepassxc
    print_external_matches "OPSEC External" \
      "*proxychains*" "*redsocks*" "*invisibility-cloak*"
    ;;
  network)
    print_category "Network" nmap tcpdump traceroute ping
    print_external_matches "Network External" \
      "*masscan*" "*naabu*" "*rustscan*" "*zgrab2*" "*bettercap*"
    ;;
  all)
    print_category "Red Team" nmap sqlmap hydra nikto
    print_category "Blue Team" suricata wireshark tcpdump ufw
    print_category "OSINT" whois curl wget
    print_category "OPSEC" tor torsocks proxychains4 keepassxc
    print_category "Network" nmap tcpdump traceroute ping
    print_external_matches "External Toolbox Paths" \
      "*metasploit*" "*sqlmap*" "*hydra*" "*nikto*" "*suricata*" "*wireshark*" \
      "*theHarvester*" "*recon-ng*" "*proxychains*" "*masscan*" "*bettercap*"
    ;;
  *)
    echo "Usage: null-tools-menu [red-team|blue-team|osint|opsec|network|all]"
    exit 1
    ;;
esac
