{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "cyan",
      "2": "white"
    }
  },
  "display": {
    "separator": " -> ",
    "color": {
      "keys": "cyan",
      "title": "white"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[36m  ███╗   ██╗██╗   ██╗██╗     ██╗     \u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[36m  ████╗  ██║██║   ██║██║     ██║     \u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[36m  ██╔██╗ ██║██║   ██║██║     ██║     \u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[36m  ██║╚██╗██║██║   ██║██║     ██║     \u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[36m  ██║ ╚████║╚██████╔╝███████╗███████╗\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[36m  ╚═╝  ╚═══╝ ╚═════╝ ╚══════╝╚══════╝\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[1m       L I N U X\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "kernel",
      "key": " Kernel"
    },
    {
      "type": "uptime",
      "key": " Uptime"
    },
    {
      "type": "packages",
      "key": " Packages"
    },
    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "de",
      "key": " DE"
    },
    {
      "type": "wm",
      "key": " WM"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "cpu",
      "key": " CPU"
    },
    {
      "type": "gpu",
      "key": " GPU"
    },
    {
      "type": "memory",
      "key": " Memory"
    },
    {
      "type": "disk",
      "key": " Disk"
    },
    {
      "type": "localip",
      "key": " Local IP"
    },
    "break",
    "colors"
  ]
}
