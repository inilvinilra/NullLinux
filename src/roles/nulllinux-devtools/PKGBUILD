  'vscodium'
  'python-virtualenv'
  'python-pipx'
  'meson'
  'ninja'
  'gdb'
  'valgrind'
  'perf'
  'strace'
  'ltrace'
  'swig'
  'pkgconf'
  'autoconf'
  'automake'
  'nasm'
  'perl'
  'lua'
  'php'
  'dotnet-sdk'
  'zig'
  'nim'
)

package() {
  install -dm755 "${pkgdir}/etc/nulllinux/roles.d"
  install -Dm644 /dev/null "${pkgdir}/etc/nulllinux/roles.d/devtools.installed"
}
