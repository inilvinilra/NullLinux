pkgname=nulllinux-forensics
pkgver=1.0.0
pkgrel=1
pkgdesc="Digital forensics, incident response, steganography, and malware triage"
arch=('any')
url="https://github.com/xredjhon/NullLinux"
license=('MIT')
depends=(
  'volatility3'
  'autopsy'
  'guymager'
  'sleuthkit'
  'scalpel'
  'ddrescue'
  'python-chepy'
  'perl-image-exiftool'
  'steghide'
  'stegseek'
  'openstego'
  'osquery'
  'binwalk'
  'foremost'
  'chkrootkit'
  'rkhunter'
  'yara'
  'bulk-extractor'
  'testdisk'
  'hashdeep'
  'python-plaso'
  'pngcheck'
  'outguess'
  'dc3dd'
  'libewf'
  'mac-robber'
  'missidentify'
  'unhide'
  'recoverjpeg'
  'ext4magic'
  'galleta'
  'pasco'
  'rifiuti2'
)

package() {
  install -dm755 "${pkgdir}/etc/nulllinux/roles.d"
  install -Dm644 /dev/null "${pkgdir}/etc/nulllinux/roles.d/forensics.installed"
}
