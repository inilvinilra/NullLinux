depends=(
  volatility3 autopsy guymager sleuthkit scalpel ddrescue
  cyberchef perl-image-exiftool steghide stegseek stegosuite
  osquery binwalk foremost chkrootkit rkhunter
  yara strelka bulk-extractor testdisk hashdeep plaso
)

package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/nulllinux/roles/forensics"
}
