depends=(
  'wireshark-qt'
  'tcpdump'
  'nmap'
  'masscan'
  'openbsd-netcat'
  'bettercap'
  'ettercap'
  'arpwatch'
  'traceroute'
  'mtr'
  'hping'
  'netdiscover'
  'iperf3'
  'dnsutils'
  'whois'
  'ngrep'
  'tshark'
  'zeek'
  'p0f'
  'dnsenum'
)

package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/nulllinux/roles/network"
}
