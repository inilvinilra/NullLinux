pkgname=nulllinux-network
pkgver=0.2.0
pkgrel=1
pkgdesc="Null Linux - Network monitoring, packet capture, IDS/IPS, and MITM tools"
arch=('any')
license=('MIT')
depends=(
  zeek suricata wireshark-qt wireshark-cli networkminer
  ettercap-gtk bettercap mitmproxy dsniff netsniff-ng
  scapy tcpdump nmap masscan openbsd-netcat arpwatch
  traceroute mtr hping netdiscover iperf3
  dnsutils whois ngrep p0f
)

package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/nulllinux/roles/network"
}
