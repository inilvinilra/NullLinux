pkgname=nulllinux-network
pkgver=1.0.0
pkgrel=2
pkgdesc="Network monitoring, packet capture, IDS/IPS, and MITM tools"
arch=('any')
url="https://github.com/xredjhon/NullLinux"
license=('MIT')
depends=(
  'zeek'
  'suricata'
  'wireshark-qt'
  'wireshark-cli'
  'networkminer'
  'ettercap-gtk'
  'bettercap'
  'mitmproxy'
  'dsniff'
  'netsniff-ng'
  'scapy'
  'tcpdump'
  'nmap'
  'masscan'
  'openbsd-netcat'
  'arpwatch'
  'traceroute'
  'mtr'
  'hping'
  'netdiscover'
  'iperf3'
  'bind'
  'whois'
  'ngrep'
  'p0f'
  'tcpreplay'
  'yersinia'
  'arping-th'
  'fping'
  'lft'
  'dnstop'
  'darkstat'
  'iftop'
  'nethogs'
  'vnstat'
  'nload'
  'termshark'
  'ssldump'
  'sslscan'
  'sslstrip'
  'responder'
)

package() {
  install -dm755 "${pkgdir}/etc/nulllinux/roles.d"
  install -Dm644 /dev/null "${pkgdir}/etc/nulllinux/roles.d/network.installed"
}
