pkgname=nulllinux-crypto
pkgver=1.0.0
pkgrel=2
pkgdesc="Cryptocurrency wallets and blockchain tools"
arch=('any')
url="https://github.com/xredjhon/NullLinux"
license=('MIT')
depends=(
  'monero-gui'
  'electrum'
  'monero'
  'trezor-suite-bin'
  'bisq-bin'
  'python-eth-utils'
  'python-web3'
)

package() {
  install -dm755 "${pkgdir}/etc/nulllinux/roles.d"
  install -Dm644 /dev/null "${pkgdir}/etc/nulllinux/roles.d/crypto.installed"
}
