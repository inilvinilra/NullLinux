  'kismet'
  'wifite'
  'hcxdumptool'
  'hcxtools'
  'reaver'
  'pixiewps'
  'hostapd-wpe'
  'freeradius'
  'fluxion'
  'bully'
  'fern-wifi-cracker'
  'cowpatty'
  'mdk4'
  'asleap'
  'eapmd5pass'
  'wifi-honey'
  'gnuradio'
  'gqrx'
  'hackrf'
  'wifiphisher'
  'iw'
  'wavemon'
  'spectools'
  'linssid'
  'sparrow-wifi'
  'macchanger'
  'wpa_supplicant'
)

package() {
  install -dm755 "${pkgdir}/etc/nulllinux/roles.d"
  install -Dm644 /dev/null "${pkgdir}/etc/nulllinux/roles.d/wireless.installed"
}
