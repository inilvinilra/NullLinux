#!/usr/bin/env bash
set -uo pipefail

VERSION="2.0.0"
TARGET="${NULL_TARGET:-/mnt}"
BACKTITLE="Null Linux Installer v${VERSION}"

# Everything the installed system receives is copied out of one tree: the live
# medium by default. Naming that tree once means a test, or a build injected at
# run time, can point the installer somewhere else without the installer growing
# a special mode — and it means no payload path is written twice.
SRC_ROOT="${NULL_SRC_ROOT:-}"
LIB_DIR="${NULL_LIB_DIR:-$SRC_ROOT/usr/share/nulllinux/lib}"
SHARE_DIR="${NULL_SHARE_DIR:-$SRC_ROOT/usr/share/nulllinux/installer}"
DATA_DIR="${NULL_DATA_DIR:-$SRC_ROOT/usr/share/nulllinux}"
SKEL_DIR="${NULL_SKEL_DIR:-$SRC_ROOT/etc/skel}"
BIN_DIR="${NULL_BIN_DIR:-$SRC_ROOT/usr/bin}"
LOG="${NULL_LOG:-/var/log/null-install.log}"

# A missing library is not a warning. Without it every valid_* check is an
# undefined command, and an installer whose input validation silently evaporates
# is worse than one that will not start.
# shellcheck source=../lib/nulllinux-validate.sh
if ! source "$LIB_DIR/nulllinux-validate.sh"; then
  printf 'null-install: cannot load %s/nulllinux-validate.sh\n' "$LIB_DIR" >&2
  exit 1
fi

RED=$'\033[0;31m'; NC=$'\033[0m'

# ── state tracked for cleanup ────────────────────────────────────────────────
MOUNTED=()
SECRETS_DIR=""
DISK=""
EFI_PART=""
ROOT_PART=""
INSTALL_STARTED=false
UNATTENDED=false

log() { printf '[%s] %s\n' "$(date -Is)" "$*" >> "$LOG"; }

die() {
  log "FATAL: $*"
  clear
  printf '%sInstallation aborted:%s %s\n\n' "$RED" "$NC" "$*" >&2
  printf 'Nothing further was written. See %s for the full log.\n' "$LOG" >&2
  exit 1
}

# Unwind everything we created, in reverse order, on any exit path.
cleanup() {
  local status=$?
  [[ -n "$SECRETS_DIR" && -d "$SECRETS_DIR" ]] && rm -rf -- "$SECRETS_DIR"
  if [[ $status -ne 0 && "$INSTALL_STARTED" == true ]]; then
    log "cleanup: unwinding after failure (status $status)"
    local m
    for (( i=${#MOUNTED[@]}-1; i>=0; i-- )); do
      m="${MOUNTED[i]}"
      umount -R "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true
    done
  fi
  return $status
}
trap cleanup EXIT
trap 'die "interrupted by signal"' INT TERM

mount_tracked() {
  mount "$@" || return 1
  MOUNTED+=("${@: -1}")
}

# ── preflight ────────────────────────────────────────────────────────────────

require_root() { [[ ${EUID} -eq 0 ]] || die "must run as root: sudo null-install"; }

require_deps() {
  local missing=()
  for cmd in dialog parted mkfs.fat mkfs.ext4 pacstrap genfstab arch-chroot \
             bootctl lsblk findmnt blkid; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  [[ ${#missing[@]} -eq 0 ]] || die "missing dependencies: ${missing[*]}"
}

require_uefi() {
  [[ -d /sys/firmware/efi/efivars ]] && return 0
  # Unattended runs have no one to read a dialog, and a blocking one would hang
  # the machine until the harness gives up with no reason recorded.
  if $UNATTENDED; then
    die "this installer supports UEFI only; the machine booted in legacy BIOS mode"
  fi
  dialog --backtitle "$BACKTITLE" --title "UEFI required" --msgbox "\
This installer supports UEFI systems only.\n\n\
The machine was booted in legacy BIOS mode. Null Linux does not yet\n\
support installing to BIOS systems, and will not pretend otherwise.\n\n\
Reboot in UEFI mode to install." 12 62
  exit 1
}

detect_microcode() {
  local vendor
  vendor="$(grep -m1 '^vendor_id' /proc/cpuinfo | awk '{print $3}')"
  case "$vendor" in
    GenuineIntel) printf 'intel-ucode' ;;
    AuthenticAMD) printf 'amd-ucode' ;;
    *) printf '' ;;
  esac
}

# Devices backing the running live system must never be offered as targets.
#
# Any absolute path a filesystem is mounted from counts, not just one under
# /dev: the list is only ever compared against a chosen target, so casting it
# wider can refuse an install but can never permit one.
emit_source_and_parent() {
  local src="$1" parent
  [[ -n "$src" && "$src" == /* ]] || return 0
  printf '%s\n' "$src"
  parent="$(lsblk -nro PKNAME "$src" 2>/dev/null | head -1)"
  [[ -n "$parent" ]] && printf '/dev/%s\n' "$parent"
  return 0
}

live_devices() {
  local src
  for mp in /run/archiso/bootmnt / /run/archiso/cowspace; do
    src="$(findmnt -nro SOURCE --target "$mp" 2>/dev/null | head -1)" || continue
    emit_source_and_parent "$src"
  done
  # Anything currently mounted is in use; treat its whole disk as unsafe.
  while IFS= read -r src; do
    emit_source_and_parent "$src"
  done < <(findmnt -nro SOURCE | sort -u)
}

MIN_DISK_BYTES=$(( 20 * 1000 * 1000 * 1000 ))

select_disk() {
  local unsafe
  unsafe="$(live_devices | sort -u)"

  local -a menu=()
  local path type size model rm_flag
  while read -r path type; do
    [[ "$type" == disk ]] || continue
    # zram, loop, optical and read-only devices are never install targets.
    case "$path" in /dev/zram*|/dev/loop*|/dev/sr*|/dev/fd*) continue ;; esac
    grep -qxF "$path" <<<"$unsafe" && continue
    [[ "$(lsblk -dnro RO "$path" 2>/dev/null)" == "1" ]] && continue

    size="$(lsblk -dnbro SIZE "$path" 2>/dev/null)"
    [[ -n "$size" && "$size" -ge $MIN_DISK_BYTES ]] || continue
    model="$(lsblk -dnro MODEL "$path" 2>/dev/null | tr -d '\n' | cut -c1-28)"
    rm_flag="$(lsblk -dnro RM "$path" 2>/dev/null)"
    [[ "$rm_flag" == "1" ]] && model="${model} [removable]"

    menu+=("$path" "$(numfmt --to=iec --suffix=B "$size" 2>/dev/null || echo "$size") ${model:-unknown}")
  done < <(lsblk -dnro PATH,TYPE)

  if [[ ${#menu[@]} -eq 0 ]]; then
    dialog --backtitle "$BACKTITLE" --msgbox "\
No installable disk was found.\n\n\
Disks are excluded when they are in use by the live system, are\n\
read-only, or are smaller than 20 GB." 10 60
    exit 1
  fi

  DISK="$(dialog --backtitle "$BACKTITLE" --title "Select target disk" \
    --menu "\nEverything on the chosen disk will be destroyed.\nDisks in use by the live system are not listed.\n" \
    18 70 8 "${menu[@]}" 3>&1 1>&2 2>&3)" || exit 0
}

describe_disk() {
  local out
  out="$(lsblk -o PATH,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$DISK" 2>/dev/null)"
  printf '%s' "$out"
}

confirm_destroy() {
  local existing
  existing="$(describe_disk)"

  dialog --backtitle "$BACKTITLE" --title "This will destroy data" --yesno "\
Target: ${DISK}\n\n\
Current contents:\n${existing}\n\n\
All of it will be erased. Continue?" 20 72 || exit 0

  local typed
  typed="$(dialog --backtitle "$BACKTITLE" --title "Confirm target" --inputbox "\
\nType the full device path to confirm erasing it:\n\n  ${DISK}\n" 12 60 \
    3>&1 1>&2 2>&3)" || exit 0

  [[ "$typed" == "$DISK" ]] || {
    dialog --backtitle "$BACKTITLE" --msgbox "Confirmation did not match. Nothing was changed." 7 52
    exit 0
  }
}

# ── configuration ────────────────────────────────────────────────────────────

ask_validated() {
  local title="$1" prompt="$2" default="$3" validator="$4" value
  while true; do
    value="$(dialog --backtitle "$BACKTITLE" --title "$title" \
      --inputbox "$prompt" 9 60 "$default" 3>&1 1>&2 2>&3)" || exit 0
    if "$validator" "$value"; then
      printf '%s' "$value"
      return 0
    fi
    dialog --backtitle "$BACKTITLE" --msgbox "\"$value\" is not valid. Try again." 7 52
  done
}

ask_password() {
  local title="$1" prompt="$2" required="$3" value confirm
  while true; do
    value="$(dialog --backtitle "$BACKTITLE" --title "$title" --insecure \
      --passwordbox "$prompt" 9 60 3>&1 1>&2 2>&3)" || {
      [[ "$required" == required ]] && continue
      printf ''; return 0
    }
    if [[ -z "$value" ]]; then
      [[ "$required" == required ]] || { printf ''; return 0; }
      dialog --backtitle "$BACKTITLE" --msgbox "A password is required." 7 40
      continue
    fi
    confirm="$(dialog --backtitle "$BACKTITLE" --title "$title (confirm)" --insecure \
      --passwordbox "Re-enter the password:" 9 60 3>&1 1>&2 2>&3)" || continue
    [[ "$value" == "$confirm" ]] && { printf '%s' "$value"; return 0; }
    dialog --backtitle "$BACKTITLE" --msgbox "Passwords did not match." 7 40
  done
}

get_config() {
  HOSTNAME_VALUE="$(ask_validated "Hostname" "\nLowercase letters, digits and hyphens." "null" valid_hostname)"
  USERNAME_VALUE="$(ask_validated "Username" "\nLowercase letters, digits, underscore and hyphen." "null" valid_username)"
  TIMEZONE_VALUE="$(ask_validated "Timezone" "\nFor example Europe/Istanbul or UTC." "UTC" valid_timezone)"

  USER_PASSWORD="$(ask_password "User password" "Password for ${USERNAME_VALUE}:" required)"
  ROOT_PASSWORD="$(ask_password "Root password" "Root password (empty locks the root account):" optional)"

  dialog --backtitle "$BACKTITLE" --title "Third-party repositories" --yesno "\
\nEnable BlackArch and Chaotic-AUR on the installed system?\n\n\
They provide most security tooling, but they are maintained by\n\
third parties and are not covered by Arch's security process.\n\n\
You can enable them later. Default is no." 13 66
  ENABLE_THIRD_PARTY=$([[ $? -eq 0 ]] && echo true || echo false)
}

# ── execution ────────────────────────────────────────────────────────────────

step() {
  local label="$1"; shift
  log "step: $label"
  if $UNATTENDED; then
    printf '==> %s\n' "$label"
  else
    dialog --backtitle "$BACKTITLE" --infobox "$label..." 3 60
  fi
  if ! "$@" >> "$LOG" 2>&1; then
    die "$label failed. See $LOG"
  fi
}

do_partition() {
  INSTALL_STARTED=true
  wipefs -a "$DISK" || return 1
  parted -s "$DISK" mklabel gpt || return 1
  parted -s "$DISK" mkpart ESP fat32 1MiB 1025MiB || return 1
  parted -s "$DISK" set 1 esp on || return 1
  parted -s "$DISK" mkpart ROOT ext4 1025MiB 100% || return 1
  udevadm settle || true

  EFI_PART="$(partition_path "$DISK" 1)"
  ROOT_PART="$(partition_path "$DISK" 2)"
  [[ -b "$EFI_PART" && -b "$ROOT_PART" ]] || return 1

  mkfs.fat -F32 "$EFI_PART" || return 1
  mkfs.ext4 -F "$ROOT_PART" || return 1

  mount_tracked "$ROOT_PART" "$TARGET" || return 1
  mkdir -p "$TARGET/boot" || return 1
  mount_tracked "$EFI_PART" "$TARGET/boot" || return 1
}

do_pacstrap() {
  local -a packages=(
    base linux linux-firmware mkinitcpio sudo
    nano vim less man-db bash-completion
    networkmanager iwd openssh nftables ufw
    dosfstools e2fsprogs btrfs-progs efibootmgr exfatprogs parted
    plasma-desktop plasma-workspace plasma-nm plasma-pa plasma-systemmonitor
    plasma-x11-session polkit-kde-agent qt6-wayland sddm dolphin konsole kate
    xdg-desktop-portal-kde xdg-user-dirs xdg-utils breeze breeze-gtk
    kde-gtk-config kwallet-pam kscreen powerdevil
    mesa vulkan-icd-loader ttf-dejavu ttf-liberation noto-fonts
    adwaita-icon-theme papirus-icon-theme archlinux-keyring
    dialog firefox git
  )
  [[ -n "$MICROCODE" ]] && packages+=("$MICROCODE")
  pacstrap -K "$TARGET" "${packages[@]}"
}

do_fstab() { genfstab -U "$TARGET" > "$TARGET/etc/fstab"; }

# Identity, defaults and tooling are installed as files we own, not copied
# opportunistically out of the live filesystem.
do_identity() {
  # Required: without any of these the installed system is not Null Linux, and
  # saying so afterwards is better than shipping a system missing its desktop.
  install -Dm644 "$SHARE_DIR/os-release" "$TARGET/etc/os-release" || return 1
  install -Dm644 "$SHARE_DIR/sddm.conf" "$TARGET/etc/sddm.conf.d/10-null-linux.conf" || return 1

  install -dm755 "$TARGET/usr/share/nulllinux/lib"
  install -Dm644 "$LIB_DIR"/*.sh -t "$TARGET/usr/share/nulllinux/lib/" || return 1

  local f
  for f in null-toolkit null-setup null-setup-firstrun null-repo null-apply-branding; do
    [[ -f "$BIN_DIR/$f" ]] || { printf 'missing tool: %s/%s\n' "$BIN_DIR" "$f" >&2; return 1; }
    install -Dm755 "$BIN_DIR/$f" "$TARGET/usr/bin/$f" || return 1
  done

  local d
  for d in roles desktop-entries hooks; do
    [[ -d "$DATA_DIR/$d" ]] || { printf 'missing data: %s/%s\n' "$DATA_DIR" "$d" >&2; return 1; }
    install -dm755 "$TARGET/usr/share/nulllinux/$d"
    cp -a "$DATA_DIR/$d/." "$TARGET/usr/share/nulllinux/$d/" || return 1
  done

  install -dm755 "$TARGET/usr/share/desktop-directories"
  cp -a "$SRC_ROOT"/usr/share/desktop-directories/nulllinux-*.directory \
        "$TARGET/usr/share/desktop-directories/" || return 1
  install -Dm644 "$SRC_ROOT/usr/share/libalpm/hooks/nulllinux-desktop-entries.hook" \
        "$TARGET/usr/share/libalpm/hooks/nulllinux-desktop-entries.hook" || return 1
  install -Dm644 "$SRC_ROOT/etc/xdg/menus/applications-merged/nulllinux-security.menu" \
        "$TARGET/etc/xdg/menus/applications-merged/nulllinux-security.menu" || return 1

  # The full KDE skel, so the installed desktop matches the live one.
  [[ -d "$SKEL_DIR" ]] || { printf 'missing skel: %s\n' "$SKEL_DIR" >&2; return 1; }
  cp -a "$SKEL_DIR/." "$TARGET/etc/skel/" || return 1

  # Optional: absent on a host that is not the live image, and not worth failing for.
  cp -a "$SRC_ROOT/usr/share/wallpapers/NullLinux" "$TARGET/usr/share/wallpapers/" 2>/dev/null || true
  install -Dm644 "$SRC_ROOT/etc/ssh/sshd_config.d/10-null-linux.conf" \
        "$TARGET/etc/ssh/sshd_config.d/10-null-linux.conf" 2>/dev/null || true

  if [[ "$ENABLE_THIRD_PARTY" == true ]]; then
    cp -f "$SRC_ROOT/etc/pacman.conf" "$TARGET/etc/pacman.conf" || return 1
    cp -f "$SRC_ROOT/etc/pacman.d/blackarch-mirrorlist" "$TARGET/etc/pacman.d/" 2>/dev/null || true
    cp -f "$SRC_ROOT/etc/pacman.d/chaotic-mirrorlist" "$TARGET/etc/pacman.d/" 2>/dev/null || true
  fi
  return 0
}

do_chroot_config() {
  local root_uuid
  root_uuid="$(blkid -s UUID -o value "$ROOT_PART")" || return 1
  [[ -n "$root_uuid" ]] || return 1

  SECRETS_DIR="$TARGET/run/nulllinux"
  install -dm700 "$SECRETS_DIR"
  if [[ -n "$USER_PASSWORD" ]]; then
    (umask 077; printf '%s' "$USER_PASSWORD" | openssl passwd -6 -stdin > "$SECRETS_DIR/user.hash")
  fi
  if [[ -n "$ROOT_PASSWORD" ]]; then
    (umask 077; printf '%s' "$ROOT_PASSWORD" | openssl passwd -6 -stdin > "$SECRETS_DIR/root.hash")
  fi

  install -Dm755 "$SHARE_DIR/postinstall.sh" "$TARGET/usr/local/bin/null-postinstall"

  arch-chroot "$TARGET" env \
    NULL_HOSTNAME="$HOSTNAME_VALUE" \
    NULL_USERNAME="$USERNAME_VALUE" \
    NULL_TIMEZONE="$TIMEZONE_VALUE" \
    NULL_ROOT_UUID="$root_uuid" \
    NULL_MICROCODE="$MICROCODE" \
    /usr/local/bin/null-postinstall
  local rc=$?

  rm -rf -- "$SECRETS_DIR"; SECRETS_DIR=""
  rm -f "$TARGET/usr/local/bin/null-postinstall"

  arch-chroot "$TARGET" chown -R "${USERNAME_VALUE}:${USERNAME_VALUE}" \
    "/home/${USERNAME_VALUE}" 2>/dev/null || true
  return $rc
}

verify_install() {
  local problems=()
  [[ -f "$TARGET/etc/os-release" ]] && grep -q '^ID=nulllinux' "$TARGET/etc/os-release" \
    || problems+=("Null Linux identity missing")
  [[ -s "$TARGET/etc/fstab" ]] || problems+=("fstab is empty")
  [[ -e "$TARGET/boot/vmlinuz-linux" ]] || problems+=("kernel missing")
  [[ -e "$TARGET/boot/initramfs-linux.img" ]] || problems+=("initramfs missing")
  [[ -e "$TARGET/boot/loader/entries/null-linux.conf" ]] || problems+=("boot entry missing")
  [[ -d "$TARGET/home/${USERNAME_VALUE}" ]] || problems+=("user home missing")
  grep -q "^${USERNAME_VALUE}:" "$TARGET/etc/passwd" || problems+=("user not created")
  [[ -f "$TARGET/etc/sudoers.d/01-wheel" ]] || problems+=("sudo policy missing")
  [[ -d "$TARGET/usr/share/nulllinux/roles" ]] && \
    compgen -G "$TARGET/usr/share/nulllinux/roles/*.role" >/dev/null \
    || problems+=("role data missing")
  [[ -x "$TARGET/usr/bin/null-toolkit" ]] || problems+=("role manager missing")
  [[ -f "$TARGET/etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc" ]] \
    || problems+=("KDE panel layout missing")
  [[ -f "$TARGET/usr/share/libalpm/hooks/nulllinux-desktop-entries.hook" ]] \
    || problems+=("desktop entry hook missing")
  [[ -e "$TARGET/etc/sudoers.d/10-null" ]] && problems+=("live passwordless sudo leaked")

  if [[ ${#problems[@]} -gt 0 ]]; then
    printf '%s\n' "${problems[@]}"
    return 1
  fi
  return 0
}

# Unattended mode exists for automated tests. It reads every answer from a file,
# validates them exactly like the interactive path, and requires the file to name
# the target device explicitly and to confirm destruction in writing.
load_answers() {
  local file="$1"
  [[ -f "$file" ]] || die "answer file not found: $file"

  local key value
  while IFS='=' read -r key value; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    case "$key" in
      disk) DISK="$value" ;;
      hostname) HOSTNAME_VALUE="$value" ;;
      username) USERNAME_VALUE="$value" ;;
      timezone) TIMEZONE_VALUE="$value" ;;
      user_password) USER_PASSWORD="$value" ;;
      root_password) ROOT_PASSWORD="$value" ;;
      third_party_repos) ENABLE_THIRD_PARTY="$value" ;;
      confirm_destroy_device) CONFIRM_DEVICE="$value" ;;
      *) die "unknown key in answer file: $key" ;;
    esac
  done < "$file"

  : "${DISK:?answer file must set disk}"
  : "${CONFIRM_DEVICE:=}"
  : "${HOSTNAME_VALUE:=null}"
  : "${USERNAME_VALUE:=null}"
  : "${TIMEZONE_VALUE:=UTC}"
  : "${USER_PASSWORD:=}"
  : "${ROOT_PASSWORD:=}"
  : "${ENABLE_THIRD_PARTY:=false}"

  [[ "$CONFIRM_DEVICE" == "$DISK" ]] || \
    die "confirm_destroy_device must repeat the exact target device path"
  [[ -b "$DISK" ]] || die "not a block device: $DISK"
  valid_hostname "$HOSTNAME_VALUE" || die "invalid hostname: $HOSTNAME_VALUE"
  valid_username "$USERNAME_VALUE" || die "invalid username: $USERNAME_VALUE"
  valid_timezone "$TIMEZONE_VALUE" || die "invalid timezone: $TIMEZONE_VALUE"
  [[ -n "$USER_PASSWORD" ]] || die "answer file must set user_password"

  # Even unattended, the live medium and mounted disks are never valid targets.
  local unsafe
  unsafe="$(live_devices | sort -u)"
  grep -qxF "$DISK" <<<"$unsafe" && die "$DISK is in use by the running system"
  return 0
}

# Every message the installer shows after work has begun has to survive an
# unattended run. A dialog nobody can dismiss does not fail the install — it
# hangs it, which is worse, because the log stops with the last thing that
# worked and looks like a crash.
report_success() {
  local body="\
Null Linux is installed and verified.

  Hostname:  ${HOSTNAME_VALUE}
  User:      ${USERNAME_VALUE}
  Boot:      systemd-boot (UEFI), fallback entry included
  Firewall:  incoming denied
  SSH:       installed, not enabled

Filesystems are unmounted. Remove the installation medium
and reboot.

Run 'null-setup' after first login to add tools."

  if $UNATTENDED; then
    printf '%s\n' "$body"
    return 0
  fi
  dialog --backtitle "$BACKTITLE" --title "Installation complete" \
    --msgbox "$body" 20 64
  clear
}

main() {
  if [[ "${1:-}" == "--unattended" ]]; then
    UNATTENDED=true
    [[ -n "${2:-}" ]] || die "usage: null-install --unattended <answer-file>"
  fi

  require_root
  require_deps
  install -dm755 "$(dirname "$LOG")"
  log "null-install ${VERSION} starting"
  require_uefi

  MICROCODE="$(detect_microcode)"

  if $UNATTENDED; then
    load_answers "$2"
    printf 'Unattended installation to %s\n' "$DISK"
  else
  dialog --backtitle "$BACKTITLE" --title "Null Linux Installer" --yesno "\
\n  This installs Null Linux with a KDE Plasma desktop.\n\n\
  Current scope: UEFI, GPT, unencrypted ext4.\n\
  Disk encryption is not implemented yet.\n\n\
  Security tools are installed after first boot, by choice.\n\n  Continue?" 15 62 || exit 0

  select_disk
  confirm_destroy
  get_config

  local summary="Disk:      ${DISK}\nHostname:  ${HOSTNAME_VALUE}\nUser:      ${USERNAME_VALUE}\n"
  summary+="Timezone:  ${TIMEZONE_VALUE}\nMicrocode: ${MICROCODE:-none detected}\n"
  summary+="Root:      $([[ -n "$ROOT_PASSWORD" ]] && echo "password set" || echo "locked")\n"
  summary+="3rd-party repos: ${ENABLE_THIRD_PARTY}\n\nStart the installation?"
  dialog --backtitle "$BACKTITLE" --title "Review" --yesno "$summary" 17 62 || exit 0
  fi

  step "Partitioning ${DISK}" do_partition
  step "Installing the base system (this takes a while)" do_pacstrap
  step "Generating fstab" do_fstab
  step "Installing Null Linux identity and defaults" do_identity
  step "Configuring the installed system" do_chroot_config

  local problems
  if ! problems="$(verify_install)"; then
    if $UNATTENDED; then
      printf 'VERIFICATION FAILED:\n%s\n' "$problems" >&2
    else
      dialog --backtitle "$BACKTITLE" --title "Installation incomplete" --msgbox "\
The installation did not pass verification:\n\n${problems}\n\n\
The target is left mounted at ${TARGET} for inspection.\n\
Log: ${LOG}" 16 64
    fi
    exit 1
  fi

  INSTALL_STARTED=false
  umount -R "$TARGET" 2>/dev/null || true

  report_success
  log "installation completed successfully"
}

main "$@"
