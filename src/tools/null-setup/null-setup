#!/usr/bin/env bash
set -uo pipefail

VERSION="2.0.0"
LIB_DIR="${NULL_LIB_DIR:-/usr/share/nulllinux/lib}"
BACKTITLE="Null Linux Setup v${VERSION}"
STATE="${XDG_CONFIG_HOME:-$HOME/.config}/nulllinux-setuprc"

# shellcheck source=../../lib/nulllinux-pkg.sh
source "$LIB_DIR/nulllinux-pkg.sh"

command -v dialog >/dev/null 2>&1 || { echo "dialog is required: pacman -S dialog"; exit 1; }

# Package operations need root. Asking once, up front, is honest and keeps the
# password prompt out of the progress window where it would be invisible.
if [[ ${EUID} -ne 0 ]]; then
  if ! sudo -v 2>/dev/null; then
    dialog --backtitle "$BACKTITLE" --msgbox \
      "Administrator rights are required to install packages.\n\nRun 'null-setup' again and provide your password." 9 56
    clear; exit 1
  fi
  # The engine escalates with a prefix; it must not be folded into the command
  # name, or the shell looks for a program literally called "sudo pacman".
  # shellcheck disable=SC2034  # read by the sourced engine, not by this file
  NULL_PACMAN_PREFIX=sudo
fi

mark_first_run_done() {
  mkdir -p "$(dirname "$STATE")"
  printf '[General]\nFirstRunDone=true\n' > "$STATE"
}

summary_text() {
  local result="$1"
  local text
  text="Result: $(result_name "$result")\n\n"
  text+="Installed:        ${#PKG_INSTALLED[@]}\n"
  text+="Already present:  ${#PKG_ALREADY[@]}\n"
  text+="Unresolved:       ${#PKG_FAILED[@]}\n"
  if [[ ${#PKG_FAILED[@]} -gt 0 ]]; then
    text+="\nUnresolved packages:\n"
    local p
    for p in "${PKG_FAILED[@]}"; do text+="  - ${p}\n"; done
    text+="\nThese are not installed. Nothing was marked complete."
  fi
  printf '%b' "$text"
}

install_roles() {
  local -a roles=("$@")
  local role result overall=$NULL_RESULT_UNCHANGED
  local -a all_failed=()

  local n=${#roles[@]} i=0
  for role in "${roles[@]}"; do
    i=$((i + 1))
    local -a pkgs=()
    mapfile -t pkgs < <(role_packages "$role")

    # Which packages this run is responsible for has to be settled before the
    # transaction: anything already present belongs to whatever put it there,
    # and removing the role later must not take it away.
    local p
    local -a wanted=()
    for p in "${pkgs[@]}"; do pacman_q "$p" || wanted+=("$p"); done

    (
      printf 'Installing %s (%d packages)\n\n' "$(role_field "$role" name)" "${#pkgs[@]}"
      pkg_install "${pkgs[@]}"
      printf '\nResult: %s\n' "$(result_name $?)"
    ) | dialog --backtitle "$BACKTITLE" --title "[$i/$n] $(role_field "$role" name)" \
        --programbox 24 78

    # Re-derive the outcome from the package database rather than from the
    # pipeline's exit status, which belongs to dialog. pkg_install ran in a
    # subshell, so its arrays never reached this one.
    local -a gained=() missing=()
    for p in "${wanted[@]}"; do
      if pacman_q "$p"; then gained+=("$p"); else missing+=("$p"); fi
    done

    # The role is recorded as chosen as soon as any of its packages is present,
    # complete or not, so a partial role can still be undone — and the owned
    # list stays limited to what this run installed. A role where nothing landed
    # at all is not recorded: there is nothing to own and nothing to undo.
    local present=$(( ${#pkgs[@]} - ${#missing[@]} ))
    [[ $present -gt 0 ]] && state_write "$role" "${gained[@]}"

    if [[ ${#missing[@]} -eq 0 ]]; then
      result=$NULL_RESULT_COMPLETE
    else
      result=$NULL_RESULT_PARTIAL
      all_failed+=("${missing[@]}")
    fi
    [[ $result -gt $overall ]] && overall=$result
  done

  if [[ ${#all_failed[@]} -gt 0 ]]; then
    local text="Some packages could not be installed.\n\n"
    local p
    for p in "${all_failed[@]}"; do text+="  - ${p}\n"; done
    text+="\nAffected roles were NOT marked complete."
    dialog --backtitle "$BACKTITLE" --title "Incomplete" --msgbox "$text" 20 66
  else
    dialog --backtitle "$BACKTITLE" --title "Done" \
      --msgbox "All selected roles installed and verified." 7 50
  fi
}

menu_roles() {
  local -a items=()
  local role
  while IFS= read -r role; do
    items+=("$role" "$(role_field "$role" name) ($(role_packages "$role" | wc -l) pkgs)" off)
  done < <(role_ids)

  local count=$(( ${#items[@]} / 3 ))
  [[ $count -eq 0 ]] && { dialog --backtitle "$BACKTITLE" --msgbox "No roles found in $NULL_ROLE_DIR" 6 56; return; }

  local selected
  selected="$(dialog --backtitle "$BACKTITLE" --title "Select Roles" \
    --checklist "\nSpace toggles, Enter confirms.\nPackages come from the repositories configured on this system.\n" \
    $(( count + 9 )) 74 "$count" "${items[@]}" 3>&1 1>&2 2>&3)" || return

  [[ -z "$selected" ]] && return
  local -a chosen=()
  for role in $selected; do chosen+=("${role//\"/}"); done
  install_roles "${chosen[@]}"
}

menu_packages() {
  local -a role_items=()
  local role
  while IFS= read -r role; do
    role_items+=("$role" "$(role_field "$role" name)")
  done < <(role_ids)

  local choice
  choice="$(dialog --backtitle "$BACKTITLE" --title "Select Category" \
    --menu "Pick a category:" 20 64 13 "${role_items[@]}" 3>&1 1>&2 2>&3)" || return
  role_exists "$choice" || return

  local -a items=()
  local pkg
  while IFS= read -r pkg; do
    local state=off tag=repo
    pacman_q "$pkg" && state=on
    pacman_si "$pkg" || tag="unavailable"
    items+=("$pkg" "[$tag]" "$state")
  done < <(role_packages "$choice")

  local count=$(( ${#items[@]} / 3 ))
  local selected
  selected="$(dialog --backtitle "$BACKTITLE" --title "Packages: $choice" \
    --checklist "\nSpace toggles, Enter installs.\n" \
    $(( count + 9 > 30 ? 30 : count + 9 )) 66 $(( count > 18 ? 18 : count )) \
    "${items[@]}" 3>&1 1>&2 2>&3)" || return
  [[ -z "$selected" ]] && return

  local -a wanted=()
  for pkg in $selected; do
    pkg="${pkg//\"/}"
    pacman_q "$pkg" || wanted+=("$pkg")
  done
  [[ ${#wanted[@]} -eq 0 ]] && {
    dialog --backtitle "$BACKTITLE" --msgbox "Everything selected is already installed." 6 52; return; }

  ( pkg_install "${wanted[@]}"; printf '\nResult: %s\n' "$(result_name $?)" ) \
    | dialog --backtitle "$BACKTITLE" --title "Installing ${#wanted[@]} package(s)" --programbox 24 78

  local failed=()
  for pkg in "${wanted[@]}"; do pacman_q "$pkg" || failed+=("$pkg"); done
  if [[ ${#failed[@]} -gt 0 ]]; then
    local text="Unresolved packages:\n\n"
    for pkg in "${failed[@]}"; do text+="  - ${pkg}\n"; done
    dialog --backtitle "$BACKTITLE" --title "Incomplete" --msgbox "$text" 18 60
  else
    dialog --backtitle "$BACKTITLE" --title "Done" --msgbox "All selected packages installed." 7 44
  fi
}

view_roles() {
  local info="" role total=0 active=0
  while IFS= read -r role; do
    total=$((total + 1))
    local st; st="$(role_status "$role")"
    case "$st" in metapackage|installed|satisfied) active=$((active + 1)) ;; esac
    info+="  $(printf '%-14s %-12s %s' "$role" "$st" "$(role_field "$role" name)")\n"
  done < <(role_ids)
  dialog --backtitle "$BACKTITLE" --title "Roles ($active of $total installed)" \
    --msgbox "\n${info}" $(( total + 9 )) 72
}

run_update() {
  dialog --backtitle "$BACKTITLE" --title "Update" \
    --yesno "Synchronise and upgrade the whole system?\n\nThis is a full upgrade, never a partial one." 9 56 || return
  ( pacman_write -Syu --noconfirm 2>&1 ) \
    | dialog --backtitle "$BACKTITLE" --title "Upgrading" --programbox 24 78
  dialog --backtitle "$BACKTITLE" --msgbox "Upgrade finished. Check the log above for details." 7 54
}

show_welcome() {
  dialog --backtitle "$BACKTITLE" --title " Welcome to Null Linux " \
    --yes-label "Start" --no-label "Exit" --yesno "\
\n  Null Linux — Arch-based security workstation\n\
\n  This wizard installs optional tool sets. Nothing is\n\
  installed until you choose it.\n\
\n  Roles available: $(role_ids | wc -l)\n\
  Unique packages:  $(role_ids | while read -r r; do role_packages "$r"; done | sort -u | wc -l)\n\
\n  Null Linux sends no telemetry and makes no network\n\
  calls of its own. Package downloads go to the mirrors\n\
  configured on this system.\n\
\n  You can run 'null-setup' again at any time." 20 62
}

main() {
  if ! show_welcome; then
    clear
    echo "Null Linux Setup — run 'null-setup' whenever you want."
    exit 0
  fi

  while true; do
    local choice
    choice="$(dialog --backtitle "$BACKTITLE" --title "Main Menu" --cancel-label "Exit" \
      --menu "Choose an option:" 17 62 6 \
      1 "Install tools by role" \
      2 "Install individual packages" \
      3 "Show role status" \
      4 "Update the system" \
      5 "Exit" 3>&1 1>&2 2>&3)" || break

    case "$choice" in
      1) menu_roles ;;
      2) menu_packages ;;
      3) view_roles ;;
      4) run_update ;;
      5) break ;;
    esac
  done

  mark_first_run_done
  clear
  echo "Null Linux setup finished. Run 'null-setup' any time to install more."
}

main "$@"
