#!/usr/bin/env bash
set -uo pipefail

VERSION="2.0.0"
LIB_DIR="${NULL_LIB_DIR:-/usr/share/nulllinux/lib}"

# shellcheck source=../../lib/nulllinux-pkg.sh
source "$LIB_DIR/nulllinux-pkg.sh"

RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; NC=''
if [[ -t 1 ]]; then
  RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[0;33m'
  CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
fi

say()  { printf '%s\n' "$*"; }
warn() { printf '%s%s%s\n' "$YELLOW" "$*" "$NC" >&2; }
err()  { printf '%s%s%s\n' "$RED" "$*" "$NC" >&2; }

require_root() {
  [[ ${EUID} -eq 0 ]] && return 0
  err "Root required: sudo null-toolkit $*"
  exit 1
}

require_role() {
  role_exists "$1" && return 0
  err "Unknown role: $1"
  say "Run 'null-toolkit list' to see available roles." >&2
  exit 1
}

status_label() {
  case "$1" in
    metapackage) printf '%sinstalled%s (metapackage)' "$GREEN" "$NC" ;;
    installed)   printf '%sinstalled%s' "$GREEN" "$NC" ;;
    satisfied)   printf '%ssatisfied%s' "$GREEN" "$NC" ;;
    degraded)    printf '%sdegraded%s' "$YELLOW" "$NC" ;;
    partial)     printf '%spartial%s' "$YELLOW" "$NC" ;;
    *)           printf '%savailable%s' "$CYAN" "$NC" ;;
  esac
}

cmd_list() {
  printf '%s%-14s %-24s %6s  %s%s\n' "$BOLD" "ROLE" "STATUS" "PKGS" "NAME" "$NC"
  local role count
  while IFS= read -r role; do
    count="$(role_packages "$role" | wc -l)"
    printf '%-14s %-24b %6s  %s\n' \
      "$role" "$(status_label "$(role_status "$role")")" "$count" "$(role_field "$role" name)"
  done < <(role_ids)
}

cmd_info() {
  local role="$1"
  require_role "$role"
  printf '%s%s (%s)%s\n' "$BOLD" "$(role_field "$role" name)" "$role" "$NC"
  printf 'Status: %b\n\n' "$(status_label "$(role_status "$role")")"

  local pkg present=0 total=0
  while IFS= read -r pkg; do
    total=$((total + 1))
    if pacman_q "$pkg"; then
      present=$((present + 1)); printf '  %s●%s %s\n' "$GREEN" "$NC" "$pkg"
    elif pacman_si "$pkg"; then
      printf '  %s○%s %s [repo]\n' "$YELLOW" "$NC" "$pkg"
    else
      printf '  %s○%s %s %s[not in configured repositories]%s\n' "$YELLOW" "$NC" "$pkg" "$RED" "$NC"
    fi
  done < <(role_packages "$role")
  printf '\n%d of %d installed\n' "$present" "$total"
}

report() {
  local result="$1" role="$2"
  printf '\n%sResult: %s%s\n' "$BOLD" "$(result_name "$result")" "$NC"
  [[ ${#PKG_INSTALLED[@]} -gt 0 ]] && printf '  installed (%d): %s\n' "${#PKG_INSTALLED[@]}" "${PKG_INSTALLED[*]}"
  [[ ${#PKG_ALREADY[@]}   -gt 0 ]] && printf '  already present (%d)\n' "${#PKG_ALREADY[@]}"
  if [[ ${#PKG_FAILED[@]} -gt 0 ]]; then
    printf '  %sunresolved (%d):%s\n' "$RED" "${#PKG_FAILED[@]}" "$NC"
    printf '    - %s\n' "${PKG_FAILED[@]}"
    printf '\n%sRole "%s" is NOT marked installed because required packages failed.%s\n' \
      "$RED" "$role" "$NC"
  fi
}

cmd_install() {
  local role="$1"
  require_root install "$role"
  require_role "$role"

  local status
  status="$(role_status "$role")"
  if [[ "$status" == metapackage ]]; then
    warn "Role '$role' is provided by the metapackage nulllinux-$role; nothing to do."
    exit "$NULL_RESULT_UNCHANGED"
  fi

  local -a pkgs=()
  mapfile -t pkgs < <(role_packages "$role")
  printf '%s%sInstalling %s (%d packages)%s\n\n' "$CYAN" "$BOLD" "$(role_field "$role" name)" "${#pkgs[@]}" "$NC"

  pkg_install "${pkgs[@]}"
  local result=$?
  report "$result" "$role"

  case "$result" in
    "$NULL_RESULT_COMPLETE" | "$NULL_RESULT_PARTIAL")
      state_write "$role" "${PKG_INSTALLED[@]}" || warn \
        "Could not record role state in $NULL_STATE_DIR; removal will not know what this role installed."
      ;;
  esac
  exit "$result"
}

cmd_remove() {
  local role="$1" dry=false
  [[ "${2:-}" == "--dry-run" ]] && dry=true
  $dry || require_root remove "$role"
  require_role "$role"

  if ! role_is_active "$role"; then
    warn "Role '$role' is not installed."
    exit "$NULL_RESULT_UNCHANGED"
  fi

  if pacman_q "nulllinux-${role}"; then
    err "Role '$role' was installed as a metapackage."
    say "Remove it with: pacman -Rs nulllinux-${role}" >&2
    exit 1
  fi

  local -a removable=() kept=()
  mapfile -t removable < <(role_removable "$role")
  mapfile -t kept < <(role_kept_shared "$role")

  printf '%s%sRemoval plan for %s%s\n\n' "$CYAN" "$BOLD" "$role" "$NC"
  if [[ ${#removable[@]} -gt 0 ]]; then
    printf '  will remove (%d):\n' "${#removable[@]}"
    printf '    - %s\n' "${removable[@]}"
  else
    printf '  will remove: nothing\n'
  fi
  if [[ ${#kept[@]} -gt 0 ]]; then
    printf '\n  %skept — required by another installed role (%d):%s\n' "$GREEN" "${#kept[@]}" "$NC"
    printf '    - %s\n' "${kept[@]}"
  fi
  printf '\n  kept — installed outside this role or not owned by null-toolkit\n'

  if $dry; then
    printf '\n(dry run: nothing was changed)\n'
    exit 0
  fi

  if [[ ${#removable[@]} -eq 0 ]]; then
    state_clear "$role"
    say "Role state cleared; no packages needed removing."
    exit "$NULL_RESULT_COMPLETE"
  fi

  printf '\nRemove these %d package(s)? [y/N] ' "${#removable[@]}"
  local answer; read -r answer
  [[ "$answer" == [yY] ]] || { say "Canceled."; exit "$NULL_RESULT_CANCELED"; }

  if pacman_write -Rns --noconfirm "${removable[@]}"; then
    state_clear "$role"
    printf '%sRole %s removed.%s\n' "$GREEN" "$role" "$NC"
    exit "$NULL_RESULT_COMPLETE"
  fi
  err "Removal transaction failed; role state left untouched."
  exit "$NULL_RESULT_FAILED"
}

cmd_update() {
  require_root update
  say "Synchronising and upgrading the whole system (never a partial upgrade)..."
  if pkg_sync_upgrade; then
    printf '%sSystem up to date.%s\n' "$GREEN" "$NC"
    exit "$NULL_RESULT_COMPLETE"
  fi
  err "Upgrade failed. The system may need attention before installing more packages."
  exit "$NULL_RESULT_FAILED"
}

cmd_search() {
  local term="$1" role hit found=false
  while IFS= read -r role; do
    while IFS= read -r hit; do
      [[ -n "$hit" ]] || continue
      found=true
      if pacman_q "$hit"; then
        printf '  %s●%s %-28s %s\n' "$GREEN" "$NC" "$hit" "$role"
      else
        printf '  %s○%s %-28s %s\n' "$YELLOW" "$NC" "$hit" "$role"
      fi
    done < <(role_packages "$role" | grep -iF -- "$term" || true)
  done < <(role_ids)
  $found || say "No matches."
}

usage() {
  cat <<EOF
${BOLD}null-toolkit${NC} v${VERSION} — Null Linux role manager

USAGE
  null-toolkit <command> [role]

COMMANDS
  install <role>            Install a role's packages
  remove  <role>            Remove a role (asks first; never removes shared packages)
  remove  <role> --dry-run  Show exactly what removal would do
  list                      List roles and their real status
  info    <role>            Show per-package status for a role
  update                    Full system synchronisation and upgrade
  search  <term>            Find a package across roles

EXIT STATUS
  0 complete   10 partial   11 failed   12 canceled   13 unchanged
EOF
}

case "${1:-}" in
  install) [[ -n "${2:-}" ]] || { usage; exit 1; }; cmd_install "$2" ;;
  remove)  [[ -n "${2:-}" ]] || { usage; exit 1; }; cmd_remove "$2" "${3:-}" ;;
  list)    cmd_list ;;
  info)    [[ -n "${2:-}" ]] || { usage; exit 1; }; cmd_info "$2" ;;
  update)  cmd_update ;;
  search)  [[ -n "${2:-}" ]] || { usage; exit 1; }; cmd_search "$2" ;;
  -v | --version) say "null-toolkit v${VERSION}" ;;
  *) usage ;;
esac
